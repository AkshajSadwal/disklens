# Optional AI providers. No key is required; DiskLens uses local rule-based analysis.
# Environment fallback provider priority is OpenAI, Anthropic, then Azure OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Environment-based fallback for Azure OpenAI (Settings also supports Azure OpenAI v1).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=high

# Local service configuration
DISKLENS_PORT=4000
DISKLENS_SERVER=http://127.0.0.1:4000
DISKLENS_WEB_ORIGIN=http://127.0.0.1:3000
