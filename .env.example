# Optional AI providers. No key is required; DiskLens uses local rule-based analysis.
# OpenAI takes precedence if both OpenAI and Anthropic keys are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Legacy Azure OpenAI support (used only when neither provider above is configured).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=high

# Local service configuration
DISKLENS_PORT=4000
DISKLENS_SERVER=http://127.0.0.1:4000
